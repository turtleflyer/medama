  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Jest Tests (medama)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "test",
        "-w",
        "medama",
        "--",
        "debug",
        "--coverage=false",
        "--runInBand"
      ],
    },
    {
      "name": "Debug Jest Tests (@medamajs/compose)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "test",
        "-w",
        "@medamajs/compose",
        "--",
        "debug",
        "--coverage=false",
        "--runInBand"
      ],
    }
  ]
}
